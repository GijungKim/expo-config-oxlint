{
  "name": "expo-config-oxlint",
  "version": "0.2.0",
  "description": "Oxlint preset for Expo apps: Expo's oxlint-config-universe/native plus the React Compiler rules (eslint-plugin-react-hooks) and Expo's lint rules via Oxlint JS plugins",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GijungKim/expo-config-oxlint"
  },
  "bugs": {
    "url": "https://github.com/GijungKim/expo-config-oxlint/issues"
  },
  "homepage": "https://github.com/GijungKim/expo-config-oxlint#readme",
  "keywords": [
    "oxlint",
    "oxc",
    "expo",
    "react-native",
    "react-compiler",
    "react-hooks",
    "eslint-config-expo",
    "lint"
  ],
  "author": "GijungKim <tonykim970@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "eslint-plugin-expo": "^1.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "oxlint-config-universe": "^0.2.0",
    "oxlint-plugin-react-native": "^0.2.26"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0"
  },
  "devDependencies": {
    "oxlint": "^1.79.0"
  }
}
